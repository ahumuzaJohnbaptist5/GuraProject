PORT=8787
DATABASE_URL=postgres://gura:gura@localhost:5432/gura
WEB_ORIGIN=http://127.0.0.1:5173
SESSION_DAYS=7
NODE_ENV=development
# Recommended for Render and other hosts that restrict SMTP egress.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=Gura <notifications@your-verified-domain.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-email@gmail.com

# Optional Pesapal API 3 hosted payments (do not enable until merchant verification and sandbox tests).
# Default sandbox; set live only after end-to-end confirmation.
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# Register https://YOUR_API_HOST/api/commerce/payment-ipn as an IPN URL with Pesapal.
PESAPAL_IPN_ID=
